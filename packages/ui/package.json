{
  "name": "@vmotiv/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared design system for every V MOTIV web portal: Tailwind CSS 4 + daisyUI themes, layout shell, modals, toasts, loaders and refresh helpers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "showcase": "vite --config showcase/vite.config.ts",
    "build:showcase": "vite build --config showcase/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "daisyui": "^5.5.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependencies": {
    "firebase": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "4.1.12",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}
