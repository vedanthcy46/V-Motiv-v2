{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.vmotiv.in/api/:path*"
    },
    {
      "source": "/((?!api/|brand/|favicon|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/scrap(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
