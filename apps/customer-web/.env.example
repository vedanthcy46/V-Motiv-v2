VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Leave same-origin API requests routed through the local Vite proxy.
# Public V MOTIV Connect QR scans call this V2 API origin. Production example:
# VITE_API_BASE=https://api.vmotiv.in/api/v1
# Optional store fallbacks used after the browser attempts vmotiv:// deep-link.
# Do not set these until the public store listings are live.
VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=in.vmotiv.customer
VITE_IOS_APP_URL=https://apps.apple.com/app/idYOUR_APP_ID

