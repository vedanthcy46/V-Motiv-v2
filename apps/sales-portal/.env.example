# Public Firebase web app configuration (safe to expose in a Vite build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local dev API: http://localhost:4100/api/v2. Production: https://api.vmotiv.in/api/v2
VITE_API_BASE=http://localhost:4100/api/v2
