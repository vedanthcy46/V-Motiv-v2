{
  "expo": {
    "name": "V MOTIV",
    "slug": "vmotiv-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vmotiv",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.vmotiv.customer",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "V MOTIV uses the camera only when you choose to scan a V MOTIV Connect QR sticker.",
        "NSMicrophoneUsageDescription": "V MOTIV uses the microphone only during a private V MOTIV Connect voice call.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.vmotiv.customer",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#020B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#061A38",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow V MOTIV to use your camera to scan V MOTIV Connect QR stickers."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020B18",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9372ce4b-bbbe-47a5-b288-77ea40a7e537"
      }
    },
    "owner": "vmotiv"
  }
}
