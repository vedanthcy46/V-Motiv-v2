NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://vmotiv_v2:CHANGE_ME@localhost:5440/vmotiv_v2_dev?schema=public
WEB_ORIGIN=http://localhost:3100
ADMIN_WEB_ORIGIN=http://localhost:3200
# Used after an employee accepts an invitation. Set production values to the
# exact deployed portal origins; never include a trailing slash.
SALES_WEB_ORIGIN=http://localhost:3300
INSPECTION_REVIEW_WEB_ORIGIN=http://localhost:3400
OPERATIONS_WEB_ORIGIN=http://localhost:3500
# Point this to the inspector app's web/deep-link gateway when it is deployed.
INSPECTOR_PORTAL_ORIGIN=http://localhost:3500
FIREBASE_PROJECT_ID=
# Use Application Default Credentials, stored OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=
RESEND_API_KEY=
EMAIL_FROM=
# Email sending is deliberately disabled until configuration is verified.
EMAIL_DELIVERY_ENABLED=false

# Cloudinary Storage for all images, videos, and files across the platform
# Option 1: Standard Cloudinary URL (e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
# Option 2: Explicit parameters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

