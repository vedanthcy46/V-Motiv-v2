NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://vmotiv_v2:CHANGE_ME@localhost:5440/vmotiv_v2_dev?schema=public
WEB_ORIGIN=http://localhost:3100
ADMIN_WEB_ORIGIN=http://localhost:3200
# Used after an employee accepts an invitation. Set production values to the
# exact deployed portal origins; never include a trailing slash.
SALES_WEB_ORIGIN=http://localhost:3300
INSPECTION_REVIEW_WEB_ORIGIN=http://localhost:3400
OPERATIONS_WEB_ORIGIN=http://localhost:3500
# Inspectors use the mobile app, not a web portal. This must match the
# registered scheme in the inspector mobile app.
INSPECTOR_MOBILE_DEEP_LINK=vmotiv://inspector
FIREBASE_PROJECT_ID=
# Use Application Default Credentials, stored OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=
RESEND_API_KEY=
EMAIL_FROM=
# Email sending is deliberately disabled until configuration is verified.
EMAIL_DELIVERY_ENABLED=false

# Cloudinary Storage for all images, videos, and files across the platform
# Option 1: Standard Cloudinary URL (e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
# Option 2: Explicit parameters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Verified in-person acceptance for walk-in sellers (see docs/audit/SELLER_IN_PERSON_ACCEPTANCE.md)
# Secret used to hash one-time codes at rest (16+ chars). Required in production.
ACCEPTANCE_OTP_SECRET=
# Twilio (leave empty to disable). Use either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Testing only: log the code to the server console instead of sending an SMS. Ignored when Twilio is configured.
SMS_SANDBOX_MODE=false

# Cashfree payments (rentals and service). Use the same Cashfree account as your other project.
# Leave CASHFREE_ENV=sandbox while testing; switch to production with live keys when ready. Keys live on the server only.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Public https address of this API (Cashfree redirects and calls back here), e.g. https://api.example.com
API_PUBLIC_URL=

# Render: the service address (https://<name>.onrender.com) is used for the keep-alive ping; KEEP_ALIVE=false turns it off
KEEP_ALIVE=
KEEP_ALIVE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Customers first served at a service desk or rental hub are emailed this link to install the app (default: the V MOTIV Play Store listing).
PLAY_STORE_URL=
