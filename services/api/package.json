{
  "name": "@vmotiv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "realtime": "tsx --env-file-if-exists=.env src/connect-realtime.ts",
    "db:generate": "prisma generate",
    "db:deploy": "node deploy-database.mjs",
    "db:repair-connect": "node repair-connect-schema.mjs",
    "db:repair-platform": "node repair-platform-schema.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:unseed": "tsx --env-file-if-exists=.env prisma/unseed.ts",
    "db:normalize-names": "tsx --env-file-if-exists=.env prisma/normalize-vehicle-names.ts",
    "seed:rental-demo": "tsx --env-file-if-exists=.env scripts/seed-rental-demo.ts",
    "unseed:rental-demo": "tsx --env-file-if-exists=.env scripts/remove-rental-demo.ts",
    "bootstrap:admin": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "mfa:enroll": "tsx --env-file-if-exists=.env scripts/enroll-phone-mfa.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jose": "^4.15.9",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "4.1.12",
    "wrangler": "^4.157.0"
  }
}
