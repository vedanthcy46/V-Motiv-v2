  depositStatus String @default("NOT_COLLECTED")
  verifiedPaidPaise BigInt @default(0)
  outstandingBalancePaise BigInt @default(0)
  finalInvoiceId String? @db.Uuid
  releaseReadiness Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  hub ServiceHub @relation(fields: [hubId], references: [id], onDelete: Restrict)
  custodyRecords ServiceCustodyRecord[]
  diagnoses ServiceDiagnosis[]
  estimates ServiceEstimate[]
  workOrders ServiceWorkOrder[]
  qcRecords ServiceQCRecord[]
  payments ServicePaymentRecord[]
  historyEvents ServiceHistoryEvent[]
  invoices ServiceInvoice[]

  @@index([customerId, status])
  @@index([hubId, status])
  @@index([requestNumber])
  @@index([vehicleId])
}

model ServiceCustodyRecord {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  type String
  odometerKm Int
  fuelChargeLevel String
  keyCount Int @default(1)
  accessoriesJson Json?
  preExistingDamageNotes String?
  damagePhotoUrls Json?
  custodyOfficerId String? @db.Uuid
  handoverByPerson String
  customerAcknowledged Boolean @default(false)
  customerSignatureUrl String?
  discrepancyNotes String?
  recordedAt DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model ServiceDiagnosis {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  technicianId String? @db.Uuid
  diagnosticSummary String
  detailedFindings String
  recommendedAction String
  photosAndScans Json?
  diagnosticFeePaise BigInt @default(0)
  isRoadTestNeeded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model ServiceEstimate {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  version Int @default(1)
  status ServiceEstimateStatus @default(DRAFT)
  subtotalPaise BigInt
  pickupDropFeePaise BigInt @default(0)
  diagnosticFeePaise BigInt @default(0)
  discountPaise BigInt @default(0)
  cgstPaise BigInt @default(0)
  sgstPaise BigInt @default(0)
  igstPaise BigInt @default(0)
  totalAmountPaise BigInt
  customerNotes String?
  internalNotes String?
  validUntil DateTime
  respondedAt DateTime?
  responseNotes String?
  createdById String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  items ServiceEstimateItem[]

  @@index([serviceRequestId, status])
}

model ServiceEstimateItem {
  id String @id @default(uuid()) @db.Uuid
  estimateId String @db.Uuid
  category String
  description String
  partNumber String?
  quantity Int @default(1)
  unitPricePaise BigInt
  totalPricePaise BigInt
  isMandatory Boolean @default(true)
  isApprovedByCustomer Boolean @default(true)

  estimate ServiceEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model ServiceWorkOrder {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  status ServiceWorkOrderStatus @default(PLANNED)
  instructions String
  assignedTechnicianId String? @db.Uuid
  startedAt DateTime?
  completedAt DateTime?
  actualHoursSpent Float?
  technicianNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model ServiceQCRecord {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  inspectorId String? @db.Uuid
  result ServiceQCResult
  checklistResults Json
  reworkReason String?
  notes String?
  passedAt DateTime?
  createdAt DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model ServicePaymentRecord {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  type String
  installmentType String?
  amountPaise BigInt
  status ServicePaymentStatus @default(PENDING)
  paymentGateway String?
  gatewayOrderId String?
  gatewayPaymentId String?
  gatewaySignature String?
  idempotencyKey String? @unique
  verifiedByFinanceId String? @db.Uuid
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model ServiceInvoice {
  id String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique
  serviceRequestId String @db.Uuid
  customerId String @db.Uuid
  estimateId String? @db.Uuid
  subtotalPaise BigInt
  diagnosticFeeCreditPaise BigInt @default(0)
  priorPaymentsCreditedPaise BigInt @default(0)
  cgstPaise BigInt @default(0)
  sgstPaise BigInt @default(0)
  igstPaise BigInt @default(0)
  totalAmountPaise BigInt
  outstandingPaise BigInt
  status String @default("ISSUED")
  pdfUri String?
  issuedAt DateTime @default(now())
  issuedById String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

