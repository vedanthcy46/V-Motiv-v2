generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
enum EmployeeRole {
  SUPER_ADMIN
  SECURITY_ADMIN
  SUPPORT_ADMIN
  SALES_EXECUTIVE
  INSPECTOR
  INSPECTION_REVIEWER
  OPERATIONS_MANAGER
  INVENTORY_MANAGER
  LISTING_EXECUTIVE
  PRICING_APPROVER
  FINANCE
  ADMIN
  AUDIT_VIEWER
}
enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}
enum MfaStatus {
  REQUIRED
  COMPLIANT
  RECOVERY_REQUIRED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  STALE
}
enum ApprovalDecisionType {
  APPROVE
  REJECT
}
enum ExportJobStatus {
  REQUESTED
  APPROVAL_PENDING
  READY
  EXPIRED
  REJECTED
  FAILED
}
enum PolicyStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}
enum EmailState {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  REVIEW_REQUIRED
}
enum VehicleListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  WITHDRAWN
}
enum TestDriveStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum AcquisitionLeadStatus {
  SUBMITTED
  QUALIFYING
  INSPECTION_SCHEDULED
  OFFER_PENDING
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
}
enum AcquisitionOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}
enum AcquisitionValuationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}
enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum PurchaseEnquiryStatus {
  RECEIVED
  IN_REVIEW
  CONTACTED
  CLOSED
}
enum SalesTaskType {
  CALL
  EMAIL
  MEETING
  INSPECTION_COORDINATION
  TEST_DRIVE_FOLLOW_UP
  QUOTATION_FOLLOW_UP
  DOCUMENT_FOLLOW_UP
}
enum SalesTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum SalesTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum LeadInteractionChannel {
  CALL
  EMAIL
  MEETING
  INTERNAL_NOTE
}
enum LeadInteractionOutcome {
  ATTEMPTED
  CONNECTED
  NO_ANSWER
  WRONG_NUMBER
  RESCHEDULE_REQUESTED
  INFORMATION_PROVIDED
}
enum InspectionRequestStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}
enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum VehicleReservationStatus {
  REQUESTED
  CONFIRMED
  EXPIRED
  CANCELLED
  RELEASED
  CONVERTED_TO_SALE
}
enum InspectionAppointmentStatus {
  ASSIGNED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}
enum InspectionReportStatus {
  DRAFT
  SYNC_PENDING
  SUBMITTED
  UNDER_REVIEW
  REWORK_REQUIRED
  APPROVED
  REJECTED
  SUPERSEDED
}
enum InspectionAnswerStatus {
  PASS
  ISSUE
  NOT_TESTED
  NOT_APPLICABLE
}
enum InspectionDefectSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}
enum InspectionReviewDecisionType {
  APPROVE
  REQUEST_CORRECTION
  REJECT
}
model User {
  id String @id @default(uuid()) @db.Uuid
  firebaseUid String @unique
  email String
  displayName String?
  phone String?
  status AccountStatus @default(ACTIVE)
  marketingConsent Boolean @default(false)
  termsAcceptedAt DateTime?
  termsVersion String?
  preferredCity String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee?
  emails EmailOutbox[]
  wishlist WishlistItem[]
  testDriveRequests TestDriveRequest[]
  acquisitionLeads AcquisitionLead[]
  savedSearches SavedSearch[]
  purchaseEnquiries PurchaseEnquiry[]
  supportCases SupportCase[]
  addresses CustomerAddress[]
  privacyRequests PrivacyRequest[]
  auditEvents AuditEvent[]
  policyVersions PolicyVersion[] @relation("PolicyVersionCreator")
  buyerQuotations BuyerQuotation[] @relation("BuyerQuotationCustomer")
  vehicleReservations VehicleReservation[] @relation("ReservationCustomer")
}
model CustomerAddress {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String
  addressLine String
  city String
  pincode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}
model PrivacyRequest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestType String
  status String @default("REQUESTED")
  details Json?
  resolution String?
  resolvedAt DateTime?
  resolvedById String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model Vehicle {
  id String @id @default(uuid()) @db.Uuid
  make String
  model String
  variant String
  manufacturingYear Int
  fuelType String
  transmission String
  odometerKm Int
  color String?
  ownershipCount Int?
  city String?
  registrationYear Int?
  bodyType String?
  engineCapacityCc Int?
  conditionSummary String?
  inspectionSummary String?
  inspectionReportUrl String?
  features String[] @default([])
  verifiedTags String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing VehicleListing?
}
model VehicleListing {
  id String @id @default(uuid()) @db.Uuid
  vehicleId String @unique @db.Uuid
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  title String
  pricePaise BigInt
  currency String @default("INR")
  status VehicleListingStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media VehicleMedia[]
  wishlist WishlistItem[]
  testDriveRequests TestDriveRequest[]
  purchaseEnquiries PurchaseEnquiry[]
  quotations BuyerQuotation[]
  reservations VehicleReservation[]
  @@index([status, publishedAt])
}
model VehicleMedia {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url String
  mediaType String @default("IMAGE")
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([listingId, displayOrder])
}
model WishlistItem {
  userId String @db.Uuid
  listingId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
}
model TestDriveRequest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  listingId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requestedDate DateTime @db.Date
  timeSlot String
  customerNotes String?
  serviceCity String
  locationPreference String @default("HUB")
  address String?
  status TestDriveStatus @default(REQUESTED)
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, listingId, requestedDate, timeSlot])
  @@index([userId, createdAt])
}
model AcquisitionLead {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerName String
  sellerPhone String
  city String
  pincode String
  make String
  model String
  variant String?
  manufacturingYear Int
  fuelType String
  transmission String
  odometerKm Int
  expectedPricePaise BigInt?
  referenceCode String @unique @default(uuid())
  registrationNumber String?
  idempotencyKey String?
  ownershipCount Int?
  registrationYear Int?
  color String?
  registrationCity String?
  insuranceValidUntil DateTime? @db.Date
  loanOutstanding Boolean?
  accidentHistory String?
  serviceHistory String?
  sellerNotes String?
  inspectionDate DateTime? @db.Date
  inspectionTimeSlot String?
  inspectionLocationType String? @default("HUB")
  inspectionAddress String?
  cancelledAt DateTime?
  status AcquisitionLeadStatus @default(SUBMITTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers AcquisitionOffer[]
  valuations AcquisitionValuation[]
  assignments SellerLeadAssignment[]
  interactions LeadInteraction[]
  tasks SalesTask[]
  inspectionRequests InspectionRequest[]
  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
}
model SellerLeadAssignment {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  employeeId String? @db.Uuid
  branchId String? @db.Uuid
  assignedById String? @db.Uuid
  reason String?
  assignedAt DateTime @default(now())
  releasedAt DateTime?
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  employee Employee? @relation("SellerLeadAssignedEmployee", fields: [employeeId], references: [userId], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@index([leadId, releasedAt])
  @@index([employeeId, releasedAt])
  @@index([branchId, releasedAt])
}
model LeadInteraction {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  employeeId String @db.Uuid
  channel LeadInteractionChannel
  outcome LeadInteractionOutcome
  notes String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  employee Employee @relation("LeadInteractionEmployee", fields: [employeeId], references: [userId], onDelete: Restrict)
  @@index([leadId, occurredAt])
  @@index([employeeId, occurredAt])
}
model SalesTask {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  assignedEmployeeId String @db.Uuid
  createdByEmployeeId String @db.Uuid
  type SalesTaskType
  status SalesTaskStatus @default(OPEN)
  priority SalesTaskPriority @default(NORMAL)
  dueAt DateTime
  details String
  expectedOutcome String?
  completedAt DateTime?
  actualOutcome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  assignedEmployee Employee @relation("SalesTaskAssignee", fields: [assignedEmployeeId], references: [userId], onDelete: Restrict)
  createdByEmployee Employee @relation("SalesTaskCreator", fields: [createdByEmployeeId], references: [userId], onDelete: Restrict)
  @@index([assignedEmployeeId, status, dueAt])
  @@index([leadId, dueAt])
}
model InspectionRequest {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  requestedByEmployeeId String @db.Uuid
  branchId String? @db.Uuid
  requestedDate DateTime? @db.Date
  timeSlot String?
  locationType String
  address String?
  notes String?
  status InspectionRequestStatus @default(REQUESTED)
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee @relation("InspectionRequestCreator", fields: [requestedByEmployeeId], references: [userId], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignment InspectionAssignment?
  reports InspectionReport[]
  @@index([status, createdAt])
  @@index([leadId, createdAt])
  @@index([branchId, status])
}
model InspectionAssignment {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  inspectorId String @db.Uuid
  assignedById String @db.Uuid
  status InspectionAppointmentStatus @default(ASSIGNED)
  scheduledAt DateTime?
  locationType String
  address String?
  instructions String?
  confirmedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request InspectionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  inspector Employee @relation("InspectionAssignmentInspector", fields: [inspectorId], references: [userId], onDelete: Restrict)
  assignedBy Employee @relation("InspectionAssignmentAssigner", fields: [assignedById], references: [userId], onDelete: Restrict)
  reports InspectionReport[]
  @@index([inspectorId, status, scheduledAt])
}
model InspectionReport {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  assignmentId String @db.Uuid
  inspectorId String @db.Uuid
  revision Int
  status InspectionReportStatus @default(DRAFT)
  templateKey String @default("vehicle-standard")
  templateVersion Int @default(1)
  identity Json @default("{}")
  startedAt DateTime?
  submittedAt DateTime?
  reviewedAt DateTime?
  recordVersion Int @default(1)
  parentReportId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request InspectionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  assignment InspectionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  inspector Employee @relation("InspectionReportInspector", fields: [inspectorId], references: [userId], onDelete: Restrict)
  parentReport InspectionReport? @relation("InspectionReportRevisions", fields: [parentReportId], references: [id], onDelete: Restrict)
  revisions InspectionReport[] @relation("InspectionReportRevisions")
  answers InspectionAnswer[]
  defects InspectionDefect[]
  media InspectionMedia[]
  reviewDecision InspectionReviewDecision?
  valuationCases AcquisitionValuation[]
  @@unique([requestId, revision])
  @@index([inspectorId, status, updatedAt])
  @@index([status, submittedAt])
}
model InspectionAnswer {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  itemKey String
  status InspectionAnswerStatus
  value Json?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  @@unique([reportId, itemKey])
}
model InspectionDefect {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  category String
  severity InspectionDefectSeverity
  description String
  location String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  @@index([reportId, severity])
}
model InspectionMedia {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  logicalMediaId String
  storageKey String
  mimeType String
  byteSize Int
  checksumSha256 String
  capturedAt DateTime?
  createdAt DateTime @default(now())
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  @@unique([reportId, logicalMediaId])
}
model InspectionReviewDecision {
  id String @id @default(uuid()) @db.Uuid
  reportId String @unique @db.Uuid
  reviewerId String @db.Uuid
  decision InspectionReviewDecisionType
  reason String?
  createdAt DateTime @default(now())
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviewer Employee @relation("InspectionReviewDecisionReviewer", fields: [reviewerId], references: [userId], onDelete: Restrict)
  @@index([reviewerId, createdAt])
}
model AcquisitionOffer {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  valuationId String? @db.Uuid
  valuation AcquisitionValuation? @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  offerAmountPaise BigInt
  validUntil DateTime
  status AcquisitionOfferStatus @default(OFFERED)
  version Int @default(1)
  terms String?
  declineReason String?
  acceptedAt DateTime?
  declinedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([leadId, createdAt])
  @@index([valuationId])
}
model AcquisitionValuation {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  inspectionReportId String @db.Uuid
  expectedResalePaise BigInt
  refurbishmentPaise BigInt @default(0)
  otherCostsPaise BigInt @default(0)
  requiredMarginPaise BigInt @default(0)
  recommendedPurchasePaise BigInt
  notes String?
  status AcquisitionValuationStatus @default(DRAFT)
  version Int @default(1)
  createdById String @db.Uuid
  approvedById String? @db.Uuid
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  inspectionReport InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Restrict)
  createdBy Employee @relation("AcquisitionValuationCreator", fields: [createdById], references: [userId], onDelete: Restrict)
  approvedBy Employee? @relation("AcquisitionValuationApprover", fields: [approvedById], references: [userId], onDelete: Restrict)
  offers AcquisitionOffer[]
  @@index([leadId, status, createdAt])
  @@index([inspectionReportId])
}
model SupportedCity {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model SavedSearch {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  query Json @default("{}")
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model PurchaseEnquiry {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  listingId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  message String?
  status PurchaseEnquiryStatus @default(RECEIVED)
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotations BuyerQuotation[]
  reservations VehicleReservation[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
model SupportCase {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject String
  category String
  description String
  status SupportCaseStatus @default(OPEN)
  referenceCode String @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies SupportCaseReply[]
  @@index([userId, createdAt])
}
model SupportCaseReply {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorType String @default("CUSTOMER")
  body String
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
}
model Employee {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role EmployeeRole
  active Boolean @default(false)
  permissions String[] @default([])
  locationIds String[] @default([]) @db.Uuid
  employeeCode String? @unique
  designation String?
  status EmployeeStatus @default(ACTIVE)
  mfaStatus MfaStatus @default(REQUIRED)
  lastAccessAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  roleAssignments EmployeeRoleAssignment[]
  branchAssignments EmployeeBranchAssignment[]
  invitations EmployeeInvitation[] @relation("ActivatedEmployee")
  invitationsCreated EmployeeInvitation[] @relation("InvitationCreator")
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions ApprovalDecision[] @relation("ApprovalDecisionActor")
  exportJobs ExportJob[] @relation("ExportRequester")
  sellerLeadAssignments SellerLeadAssignment[] @relation("SellerLeadAssignedEmployee")
  leadInteractions LeadInteraction[] @relation("LeadInteractionEmployee")
  assignedSalesTasks SalesTask[] @relation("SalesTaskAssignee")
  createdSalesTasks SalesTask[] @relation("SalesTaskCreator")
  inspectionRequestsCreated InspectionRequest[] @relation("InspectionRequestCreator")
  inspectionAssignments InspectionAssignment[] @relation("InspectionAssignmentInspector")
  inspectionAssignmentsCreated InspectionAssignment[] @relation("InspectionAssignmentAssigner")
  inspectionReports InspectionReport[] @relation("InspectionReportInspector")
  inspectionReviewDecisions InspectionReviewDecision[] @relation("InspectionReviewDecisionReviewer")
  createdValuations AcquisitionValuation[] @relation("AcquisitionValuationCreator")
  approvedValuations AcquisitionValuation[] @relation("AcquisitionValuationApprover")
  authoredQuotations BuyerQuotation[] @relation("BuyerQuotationAuthor")
  requestedDiscounts DiscountRequest[] @relation("DiscountRequester")
  decidedDiscounts DiscountRequest[] @relation("DiscountDecider")
  vehicleReservations VehicleReservation[] @relation("ReservationCreator")
}

model BuyerQuotation {
  id String @id @default(uuid()) @db.Uuid
  enquiryId String? @db.Uuid
  listingId String @db.Uuid
  customerId String @db.Uuid
  employeeId String @db.Uuid
  basePricePaise BigInt
  chargesPaise BigInt @default(0)
  chargeBreakdown Json?
  discountPaise BigInt @default(0)
  finalAmountPaise BigInt
  status QuotationStatus @default(DRAFT)
  version Int @default(1)
  validUntil DateTime
  terms String?
  customerResponseNotes String?
  acceptedAt DateTime?
  declinedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enquiry PurchaseEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  customer User @relation("BuyerQuotationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  author Employee @relation("BuyerQuotationAuthor", fields: [employeeId], references: [userId], onDelete: Restrict)
  discountRequests DiscountRequest[]
  reservations VehicleReservation[]
  @@index([enquiryId, createdAt])
  @@index([listingId, status])
  @@index([customerId, createdAt])
}

model DiscountRequest {
  id String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid
  requestedDiscountPaise BigInt
  proposedPricePaise BigInt
  reason String
  requestedById String @db.Uuid
  decidedById String? @db.Uuid
  status DiscountRequestStatus @default(PENDING)
  decisionNotes String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotation BuyerQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy Employee @relation("DiscountRequester", fields: [requestedById], references: [userId], onDelete: Restrict)
  decidedBy Employee? @relation("DiscountDecider", fields: [decidedById], references: [userId], onDelete: Restrict)
  @@index([quotationId, status])
}

model VehicleReservation {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  quotationId String? @db.Uuid
  enquiryId String? @db.Uuid
  customerId String @db.Uuid
  reservedById String @db.Uuid
  status VehicleReservationStatus @default(REQUESTED)
  expiresAt DateTime
  notes String?
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quotation BuyerQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  enquiry PurchaseEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  customer User @relation("ReservationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reservedBy Employee @relation("ReservationCreator", fields: [reservedById], references: [userId], onDelete: Restrict)
  @@index([listingId, status])
  @@index([customerId, status])
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  key EmployeeRole @unique
  name String
