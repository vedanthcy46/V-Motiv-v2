  @@index([customerId])
}

model ServicePaymentPolicy {
  id String @id @default(uuid()) @db.Uuid
  version String @unique
  name String
  description String?
  isActive Boolean @default(true)
  isApproved Boolean @default(true)
  allowZeroAdvance Boolean @default(true)
  allowPartialAdvance Boolean @default(true)
  defaultPartialAdvancePercent Int @default(25)
  diagnosticFeePaise BigInt @default(50000)
  diagnosticFeeCreditedToInvoice Boolean @default(true)
  partsAdvancePercent Int @default(50)
  partialPlans Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceHistoryEvent {
  id String @id @default(uuid()) @db.Uuid
  serviceRequestId String @db.Uuid
  fromStatus String?
  toStatus String
  title String
  description String
  actorRole String?
  actorId String? @db.Uuid
  metadata Json?
  createdAt DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}





// =============================================================
// PART 2: ADVANCE CAR RENTAL PLATFORM MODELS & ENUMS
// =============================================================

enum RentalVehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  CLEANING
  RESERVED
  RETIRED
}

enum RentalBlockReason {
  MAINTENANCE
  CLEANING
  OPERATIONAL_RESTRICTION
  ACCIDENT_REPAIR
  BUFFER
}

enum RentalBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  VEHICLE_COLLECTED
  TRIP_ACTIVE
  RETURN_INSPECTED
  SETTLED
  CANCELLED
}

enum RentalDriverKycStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum RentalExtensionStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum RentalHoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum RentalPaymentType {
  RENTAL_PREPAYMENT
  REFUNDABLE_DEPOSIT
  EXTENSION_FEE
  ADDITIONAL_CHARGES
  DEPOSIT_REFUND
}

enum RentalPaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

model RentalFleetVehicle {
  id String @id @default(uuid()) @db.Uuid
  fleetNumber String @unique
  registrationNumber String @unique
  vin String? @unique
  make String
  model String
  variant String?
  year Int
  transmission String
  fuelType String
  seats Int @default(5)
  color String
  odometerKm Int @default(0)
  fuelLevelPercent Int @default(100)
  hubId String @db.Uuid
  images Json
  status RentalVehicleStatus @default(AVAILABLE)
  // Compliance documents are optional: null means "not on file", never a made-up value.
  commercialPermitNumber String?
  commercialPermitExpiry DateTime?
  insurancePolicyNumber String?
  insuranceExpiry DateTime?
  fitnessCertExpiry DateTime?
  isEligibleForRental Boolean @default(true)
  baseDailyRatePaise BigInt
  baseHourlyRatePaise BigInt
  securityDepositPaise BigInt
  includedKmPerDay Int @default(250)
  extraKmRatePaise BigInt @default(1200)
  cleaningBufferMinutes Int @default(120)
  minRentalHours Int @default(8)
  maxRentalDays Int @default(30)
  features Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hub ServiceHub @relation(fields: [hubId], references: [id], onDelete: Restrict)
  blocks RentalVehicleBlock[]
  holds RentalBookingHold[]
  bookings RentalBooking[]

  @@index([hubId, status, isEligibleForRental])
  @@index([make, model])
}

model RentalVehicleBlock {
  id String @id @default(uuid()) @db.Uuid
  vehicleId String @db.Uuid
  reason RentalBlockReason
  startTime DateTime
  endTime DateTime
  notes String?
  createdById String? @db.Uuid
  createdAt DateTime @default(now())

  vehicle RentalFleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startTime, endTime])
}

model RentalBookingHold {
  id String @id @default(uuid()) @db.Uuid
  holdCode String @unique
  vehicleId String @db.Uuid
  customerId String @db.Uuid
  hubId String @db.Uuid
  startTime DateTime
  endTime DateTime
  expiresAt DateTime
  status RentalHoldStatus @default(ACTIVE)
  quoteSnapshot Json
  estimatedTotalPaise BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle RentalFleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  hub ServiceHub @relation(fields: [hubId], references: [id], onDelete: Restrict)
  booking RentalBooking?

  @@index([vehicleId, startTime, endTime, status, expiresAt])
  @@index([customerId, status])
}

model RentalBooking {
  id String @id @default(uuid()) @db.Uuid
  bookingNumber String @unique
  holdId String? @unique @db.Uuid
  customerId String @db.Uuid
  vehicleId String @db.Uuid
  pickupHubId String @db.Uuid
  returnHubId String @db.Uuid
  startTime DateTime
  endTime DateTime
  status RentalBookingStatus @default(PENDING_PAYMENT)
  kycStatus RentalDriverKycStatus @default(PENDING_REVIEW)
  pricingSnapshot Json
  baseFarePaise BigInt
  taxPaise BigInt
  securityDepositPaise BigInt
  totalPayablePaise BigInt
  includedKm Int
  extraKmRatePaise BigInt
  cancellationReason String?
  cancelledAt DateTime?
  customerNotes String?
  paymentPlanSnapshot Json?
  rentalPaymentStatus String? @default("NOT_PAID")
  depositStatus String? @default("NOT_COLLECTED")
  balanceDueAt DateTime?
  verifiedPaidPaise BigInt @default(0)
  outstandingBalancePaise BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle RentalFleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  pickupHub ServiceHub @relation("RentalPickupHub", fields: [pickupHubId], references: [id], onDelete: Restrict)
  returnHub ServiceHub @relation("RentalReturnHub", fields: [returnHubId], references: [id], onDelete: Restrict)
  hold RentalBookingHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)
  trip RentalTrip?
  driverVerification RentalDriverVerification?
  agreement RentalAgreementAcceptance?
  payments RentalPaymentRecord[]
  extensions RentalExtension[]
  damageClaims RentalDamageClaim[]
  auditEvents RentalAuditEvent[]

  @@index([customerId, status])
  @@index([vehicleId, startTime, endTime, status])
  @@index([pickupHubId, status])
}

model RentalDriverVerification {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid
  customerId String @db.Uuid
  licenseNumber String
  licenseExpiry DateTime
  licenseCategory String @default("LMV")
  dateOfBirth DateTime
  drivingExperienceYears Int
  licenseFrontUrl String
  licenseBackUrl String
  status RentalDriverKycStatus @default(PENDING_REVIEW)
  rejectionReason String?
  verifiedById String? @db.Uuid
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

model RentalAgreementAcceptance {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid
  customerId String @db.Uuid
  termsVersion String
  acceptedAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model RentalTrip {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid
  pickupTime DateTime?
  pickupOdometerKm Int?
  pickupFuelPercent Int?
  pickupPhotos Json?
  pickupNotes String?
  pickupStaffId String? @db.Uuid
  pickupCustomerSigned Boolean @default(false)
  returnTime DateTime?
  returnOdometerKm Int?
  returnFuelPercent Int?
  returnPhotos Json?
  returnNotes String?
  returnStaffId String? @db.Uuid
  returnCustomerSigned Boolean @default(false)
  excessKm Int @default(0)
  excessKmChargePaise BigInt @default(0)
  fuelRefillChargePaise BigInt @default(0)
  lateReturnChargePaise BigInt @default(0)
  damageChargePaise BigInt @default(0)
  totalAdditionalChargesPaise BigInt @default(0)
  depositRefundPaise BigInt @default(0)
  isSettled Boolean @default(false)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model RentalExtension {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  originalEndTime DateTime
  requestedEndTime DateTime
  additionalHours Int
  additionalFarePaise BigInt
  additionalTaxPaise BigInt
  totalPayablePaise BigInt
  status RentalExtensionStatus @default(REQUESTED)
  reviewedById String? @db.Uuid
  reviewedAt DateTime?
  paymentRecordId String? @db.Uuid
  createdAt DateTime @default(now())

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

model RentalDamageClaim {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  description String
  estimatedRepairCostPaise BigInt
  photos Json
  reportedByStaffId String @db.Uuid
  isCustomerDisputed Boolean @default(false)
  customerDisputeNotes String?
  resolvedCostPaise BigInt?
  resolutionNotes String?
  resolvedByFinanceId String? @db.Uuid
  status String @default("PENDING_FINANCE_REVIEW")
  createdAt DateTime @default(now())

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

model RentalPaymentRecord {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid
  type RentalPaymentType
  amountPaise BigInt
  status RentalPaymentStatus @default(PENDING)
  paymentGateway String @default("RAZORPAY")
  gatewayOrderId String?
  gatewayPaymentId String?
  gatewaySignature String?
  verifiedByFinanceId String? @db.Uuid
  verifiedAt DateTime?
  idempotencyKey String? @unique
  installmentType String?
  createdAt DateTime @default(now())

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

model RentalAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  bookingId String? @db.Uuid
  vehicleId String? @db.Uuid
  eventType String
  actorId String? @db.Uuid
  actorRole String?
  metadata Json?
  createdAt DateTime @default(now())

  booking RentalBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId, eventType])
  @@index([vehicleId])
}


model RentalPaymentPolicy {
  id String @id @default(uuid()) @db.Uuid
  version String @unique
  name String
  description String?
  isActive Boolean @default(true)
  isApproved Boolean @default(true)
  allowPartialMoreThanHours Int @default(72)
  allowPartialWindowHours Int @default(24)
  requireFullWithinHours Int @default(24)
  balanceDueHoursBeforePickup Int @default(24)
  partialPlans Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
