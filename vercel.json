{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run db:generate && npm run build -w @vmotiv/api && npm run build -w @vmotiv/customer-web",
  "outputDirectory": "apps/customer-web/dist",
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|assets/|brand/|favicon|robots|sitemap).*)", "destination": "/index.html" }
  ]
}
