{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run db:generate && npm run build -w @vmotiv/api",
  "outputDirectory": "services/api/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**",
        "node_modules/prisma/**",
        "services/api/prisma/**",
        "services/api/dist/**",
        "services/api/node_modules/.prisma/client/**",
        "services/api/node_modules/@prisma/client/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
